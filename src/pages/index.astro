---
import Base from '../layouts/Base.astro';

const TEL = "011 445 2294";
const TEL_HREF = "tel:+390114452294";
const CELL = "011 445 2294";
const WA_HREF = "https://wa.me/390114452294?text=Buongiorno%2C%20vorrei%20informazioni%20sui%20vostri%20prodotti%20e%20servizi.";
const EMAIL = "sanitariaortopedia.zanghi@gmail.com";
const INDIRIZZO = "Via Cherubini 22, 10154 Torino";
const MAPS_LINK = "https://www.google.com/maps/search/?api=1&query=Via+Cherubini+22,+10154+Torino";
const MAPS_EMBED = "https://www.google.com/maps?q=Via%20Cherubini%2022%2C%2010154%20Torino&output=embed";
const REV = "2026-10-01.1";
const WA_EVENTO = "https://wa.me/390114452294?text=Buongiorno%2C%20vorrei%20prenotare%20la%20valutazione%20baropodometrica%20gratuita%20di%20venerd%C3%AC%2016%20ottobre.";

const prodotti = [
  { t: "Busti e Corsetti", d: "Busti ortopedici e corsetteria su misura e prêt-à-porter per la colonna vertebrale.", i: "M12 3c-2 4-2 8 0 12s2 8 0 12M8 7h-2M8 12H5M8 17h-2M16 7h2M16 12h3M16 17h2" },
  { t: "Tutori e Ortesi", d: "Tutori per ginocchio, caviglia, polso, gomito e spalla. Ortesi su prescrizione.", i: "M7 4h10v6a5 5 0 0 1-10 0V4zM9 14v6M15 14v6M7 20h4M13 20h4" },
  { t: "Plantari e Calzature", d: "Plantari su misura con esame del passo — consulti in negozio solo su appuntamento — e calzature ortopediche e comfort.", i: "M3 16c4 1 7-1 9-4l3 4h6v3H3v-3z" },
  { t: "Prodotti per Incontinenza", d: "Assorbenti, pannoloni e ausili per l'incontinenza, con massima discrezione.", i: "M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z" },
  { t: "Fasce, Guaine e Cinture", d: "Fasce elastiche, guaine contenitive e cinture lombari per ogni esigenza.", i: "M4 9h16v6H4zM4 12h16M8 9v6M16 9v6" },
  { t: "Elastocompressione", d: "Calze elastiche a compressione graduata, collant e gambaletti terapeutici.", i: "M9 3h6v9l-2 9H8l1-9V3z" },
  { t: "Elettromedicali", d: "Magnetoterapia, elettrostimolatori, aerosol e apparecchi per la terapia domiciliare.", i: "M13 2L5 13h5l-1 9 8-11h-5l1-9z" },
  { t: "Estetica, Sport e Benessere", d: "Prodotti per il benessere quotidiano, il recupero sportivo e la cura del corpo.", i: "M12 21c-5-4-8-7-8-11a5 5 0 0 1 8-4 5 5 0 0 1 8 4c0 4-3 7-8 11z" },
  { t: "Calzature Ortopediche", d: "Scarpe ortopediche e predisposte per plantare, per uomo e donna.", i: "M4 15l4-6 4 3 8 1v4H4v-2z" },
  { t: "Saturimetri e Misurazione", d: "Pulsossimetri da dito e strumenti per l'automonitoraggio della salute.", i: "M8 4h8v8a4 4 0 0 1-8 0V4zM10 20h4M12 16v4" },
  { t: "Tape Kinesiologico", d: "Bende elastiche e tape kinesiologico per sportivi e riabilitazione.", i: "M5 5h14v4H5zM5 11h9v4H5zM5 17h6v2H5z" },
  { t: "Poltrone Relax", d: "Poltrone relax e alzapersona elettriche, anche in pronta consegna.", i: "M6 11V7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v4M4 13a2 2 0 0 1 4 0v3h8v-3a2 2 0 0 1 4 0v5H4v-5zM7 21v-3M17 21v-3" },
  { t: "Letti Elettrici", d: "Letti elettrici degenza e ausili per la camera, anche a noleggio.", i: "M3 18v-6M3 15h18v3M21 18v-4M6 12V9h5v3M3 12h18" },
  { t: "Colonna Vertebrale e Tronco", d: "Supporti e ausili per cervicale, schiena e postura del tronco.", i: "M12 3v18M12 5c-2 0-3 1-3 2s1 2 3 2 3 1 3 2-1 2-3 2M12 13c-2 0-3 1-3 2s1 2 3 2 3 1 3 2-1 2-3 2" },
  { t: "Ausili e Noleggio", d: "Carrozzine, deambulatori, stampelle e ausili per il bagno. Vendita e noleggio.", i: "M8 4h3l2 8h5M10 16a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 16a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" },
];

const marquee = ["Pratiche ASL e INAIL", "Busti su misura", "Noleggio ausili", "Plantari", "Elettromedicali", "Consulenza gratuita", "Torino · Via Cherubini 22"];
---
<Base>
  <!-- ===== HEADER ===== -->
  <header>
    <div class="wrap nav">
      <a class="logo" href="#top" aria-label="Torna all'inizio">
        <img src="/logo-symbol.png" alt="Sanitaria Ortopedia di Elisabetta Zanghi" />
      </a>
      <ul class="nav-links">
        <li><a href="#asl-inail">Pratiche ASL e INAIL</a></li>
        <li><a href="#prodotti">Prodotti</a></li>
        <li><a href="#chi-siamo">Chi Siamo</a></li>
        <li><a href="#contatti">Contatti</a></li>
      </ul>
      <div class="nav-cta">
        <a class="btn btn-ghost" href={TEL_HREF}>{TEL}</a>
        <a class="btn btn-wa" href={WA_HREF} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.3z"/></svg>
          WhatsApp
        </a>
      </div>
      <button class="menu-toggle" aria-label="Apri menu">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero" id="top">
    <div class="hero-media"><img src="https://cdn.jsdelivr.net/gh/vincenzobongiovanni80-cmyk/ortopedia-zanghi@main/public/hero-new.jpg" alt="" fetchpriority="high" /></div>

    <!-- ===== PROMO EVENTO in hero (auto-rimozione dal 17/10/2026) ===== -->
    <aside class="promo-hero" id="promo-baro" aria-label="Evento: valutazione baropodometrica gratuita venerdì 16 ottobre">
      <span class="promo-badge">Ven<br />16 Ott</span>
      <div class="promo-text">
        <strong>Valutazione Baropodometrica <em class="promo-free">Gratuita</em></strong>
        <span>Venerdì 16 ottobre, tutto il giorno · Solo su appuntamento</span>
      </div>
      <a class="promo-cta" href={WA_EVENTO} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.3z"/></svg>
        Prenota il tuo posto
      </a>
      <script is:inline>
        (function(){var b=document.getElementById('promo-baro');if(b&&Date.now()>=new Date('2026-10-17T00:00:00+02:00').getTime())b.remove();})();
      </script>
    </aside>
    <div class="wrap hero-inner">
      <span class="eyebrow">Sanitaria · Ortopedia · Torino</span>
      <h1 class="display">La cura della persona, <em>dal 1994</em> nel cuore di Torino.</h1>
      <div class="hero-sub">
        <p>Busti, tutori, plantari, ausili ed elettromedicali. E soprattutto: ti affianchiamo nelle <strong style="color:var(--cream)">pratiche ASL e INAIL</strong>, dalla prescrizione alla consegna. Ci pensiamo noi.</p>
        <div class="hero-actions">
          <a class="btn btn-wa" href={WA_HREF} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.3z"/></svg>
            Scrivici su WhatsApp
          </a>
          <a class="btn btn-ghost" href="#prodotti">
            Scopri i prodotti
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
      <div class="hero-strip">
        <div class="wrap">
          <div class="cell">
            <svg viewBox="0 0 24 24" fill="none" stroke="#E8CDBB" stroke-width="1.7"><path d="M9 12l2 2 4-5M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/></svg>
            <span><strong>Convenzione ASL e INAIL</strong><br />Pratiche gestite in sede</span>
          </div>
          <div class="cell">
            <svg viewBox="0 0 24 24" fill="none" stroke="#E8CDBB" stroke-width="1.7"><path d="M12 3v18M12 5c-2 0-3 1-3 2s1 2 3 2 3 1 3 2-1 2-3 2M12 13c-2 0-3 1-3 2s1 2 3 2 3 1 3 2-1 2-3 2"/></svg>
            <span><strong>Su misura</strong><br />Busti, plantari e calzature</span>
          </div>
          <div class="cell">
            <svg viewBox="0 0 24 24" fill="none" stroke="#E8CDBB" stroke-width="1.7"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/></svg>
            <span><strong>{INDIRIZZO}</strong><br />Parcheggio nelle vicinanze</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MARQUEE ===== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map(m => <span>{m} <i>●</i></span>)}
    </div>
  </div>

  <!-- ===== ASL / INAIL ===== -->
  <section id="asl-inail">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="eyebrow">Il nostro servizio distintivo</span>
          <h2 class="display">Pratiche <em>ASL e INAIL</em>, senza pensieri.</h2>
        </div>
        <p>Presso la nostra ortopedia potrete richiedere la fornitura di ausili, protesi e articoli sanitari attraverso le agevolazioni offerte dal Sistema Sanitario Nazionale.</p>
      </div>
      <div class="asl-grid">
        <div class="asl-copy rv">
          <p>È possibile richiedere la fornitura dei nostri prodotti <strong>in convenzione ASL o INAIL</strong> seguendo il classico iter burocratico. Non sai da dove partire? <strong>Ti accompagniamo noi, passo dopo passo.</strong></p>
          <div class="asl-quote">
            "Porta con te la ricetta del medico specialista e il codice fiscale: al resto pensiamo noi."
          </div>
          <p>Dalla verifica della documentazione alla consegna dell'ausilio, seguiamo ogni fase della pratica. Tu devi solo preoccuparti di stare meglio.</p>
          <div class="hero-actions" style="margin-top:26px">
            <a class="btn btn-taupe" href={WA_HREF} target="_blank" rel="noopener">
              Chiedi info sulla tua pratica
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
        <ol class="steps rv rv-d1">
          <li><strong>Visita e prescrizione</strong><p>Il medico specialista rilascia la prescrizione per l'ausilio o la protesi necessaria.</p></li>
          <li><strong>Vieni in negozio</strong><p>Portaci la prescrizione: verifichiamo subito la documentazione e ti indichiamo i prodotti previsti.</p></li>
          <li><strong>Presentiamo la pratica</strong><p>Ci occupiamo noi dell'inoltro all'ente: niente file, niente burocrazia per te.</p></li>
          <li><strong>Autorizzazione</strong><p>L'ASL o l'INAIL autorizzano la fornitura. Ti avvisiamo noi appena è approvata.</p></li>
          <li><strong>Consegna e collaudo</strong><p>Ritiri il prodotto in negozio: lo proviamo insieme e lo regoliamo su misura.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== PRODOTTI ===== -->
  <section class="prodotti" id="prodotti">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <img class="brand-lockup rv" src="/logo-full.png" alt="Sanitaria Ortopedia di Elisabetta Zanghi — Busti, Noleggi, Ausili, Plantari, Elettromedicali" />
          <span class="eyebrow">Il nostro assortimento</span>
          <h2 class="display">Tutto per la <em>riabilitazione</em> e il benessere.</h2>
        </div>
        <p>Un assortimento completo per l'ortopedia e la cura di tutta la famiglia. Non trovi ciò che cerchi? Lo ordiniamo per te.</p>
      </div>
      <div class="prod-grid rv rv-d1">
        {prodotti.map((p, idx) => (
          <div class="prod-card">
            <span class="num">{String(idx + 1).padStart(2, '0')}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={p.i}/></svg>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CHI SIAMO ===== -->
  <section id="chi-siamo">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-photo rv">
          <img src="https://cdn.jsdelivr.net/gh/vincenzobongiovanni80-cmyk/ortopedia-zanghi@main/public/about-new.jpg" alt="Consulenza personalizzata in negozio" loading="lazy" />
          <div class="about-badge"><span>30+</span>anni di esperienza<br />al tuo servizio</div>
        </div>
        <div class="about-copy rv rv-d1">
          <img class="about-symbol" src="/logo-symbol.png" alt="Simbolo Sanitaria Ortopedia" />
          <span class="eyebrow">Chi siamo</span>
          <h2 class="display" style="font-size:clamp(32px,3.8vw,52px);margin:16px 0 22px">Una sanitaria <em>di famiglia</em>, dove trovi ascolto vero.</h2>
          <p>Da noi non sei un numero. Ogni persona viene <strong>accolta, ascoltata e guidata</strong> verso la soluzione giusta per la propria esigenza — con la competenza di chi fa questo lavoro da una vita e la cura di sempre.</p>
          <p class="sign">— Elisabetta Zanghi</p>
          <div class="feats">
            <div><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="2"><path d="M9 12l2 2 4-5"/><circle cx="12" cy="12" r="9"/></svg> Consulenza gratuita per la scelta di tutori, busti e ausili</div>
            <div><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="2"><path d="M9 12l2 2 4-5"/><circle cx="12" cy="12" r="9"/></svg> Consulti per plantari in negozio, solo su appuntamento</div>
            <div><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="2"><path d="M9 12l2 2 4-5"/><circle cx="12" cy="12" r="9"/></svg> Gestione completa delle pratiche ASL e INAIL</div>
            <div><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="2"><path d="M9 12l2 2 4-5"/><circle cx="12" cy="12" r="9"/></svg> Noleggio di carrozzine, letti e deambulatori</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTATTI ===== -->
  <section id="contatti" style="background:var(--bg)">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <span class="eyebrow">Vieni a trovarci</span>
          <h2 class="display">Ti aspettiamo <em>in negozio.</em></h2>
        </div>
        <p>Siamo in Via Cherubini 22 a Torino. Chiamaci, scrivici su WhatsApp o compila il modulo: ti rispondiamo in giornata.</p>
      </div>
      <div class="contact-grid">
        <div class="rv">
          <div class="contact-list">
            <a class="contact-item" href={MAPS_LINK} target="_blank" rel="noopener">
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="1.8"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/></svg></span>
              <div><small>Indirizzo</small><b>{INDIRIZZO}</b><span class="sub">Apri in Google Maps</span></div>
            </a>
            <a class="contact-item" href={TEL_HREF}>
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span>
              <div><small>Telefono</small><b>{TEL}</b><span class="sub">Anche per urgenze e disponibilità prodotti</span></div>
            </a>
            <a class="contact-item" href={WA_HREF} target="_blank" rel="noopener">
              <span class="ico"><svg class="fill" viewBox="0 0 24 24" fill="#C9A88F"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.3z"/></svg></span>
              <div><small>WhatsApp</small><b>{CELL}</b><span class="sub">Risposta rapida, anche con foto del prodotto</span></div>
            </a>
            <a class="contact-item" href={`mailto:${EMAIL}`}>
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
              <div><small>Email</small><b style="word-break:break-all">{EMAIL}</b><span class="sub">Per preventivi e documenti</span></div>
            </a>
            <div class="contact-item" style="cursor:default">
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#C9A88F" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
              <div><small>Orari di apertura</small><b>Lunedì: 15:00–19:00</b><span class="sub">Martedì – Sabato: 9:00–12:30 / 15:00–19:00 · Domenica chiuso</span></div>
            </div>
          </div>
          <div class="map-frame">
            <div class="map-gdpr" id="mappa-gdpr">
              <div>
                <p>Per rispettare la tua privacy, la mappa di Google viene caricata solo su tua richiesta. Cliccando accetti i cookie di Google Maps.</p>
                <button class="btn btn-solid" type="button" id="carica-mappa">Mostra la mappa</button>
              </div>
            </div>
            <script is:inline define:vars={{ MAPS_EMBED }}>
              document.getElementById('carica-mappa').addEventListener('click', function () {
                var box = document.getElementById('mappa-gdpr');
                var f = document.createElement('iframe');
                f.src = MAPS_EMBED;
                f.title = 'Mappa: Via Cherubini 22, Torino';
                f.loading = 'lazy';
                f.referrerPolicy = 'no-referrer-when-downgrade';
                box.replaceChildren(f);
              });
            </script>
          </div>
        </div>

        <form class="quote rv rv-d1" id="form-contatti">
          <input type="hidden" name="access_key" value="9c592803-ce9b-4561-a48c-ef0745fed702" />
          <input type="hidden" name="subject" value="Nuova richiesta dal sito ortopediazanghi" />
          <input type="hidden" name="from_name" value="Sito Sanitaria Ortopedia Zanghi" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
          <h3>Richiedi informazioni</h3>
          <p>Ti ricontattiamo al più presto. Per urgenze usa WhatsApp o il telefono.</p>
          <div class="f-row">
            <div class="field">
              <label for="nome">Nome e Cognome *</label>
              <input id="nome" name="nome" type="text" required autocomplete="name" placeholder="Il tuo nome" />
            </div>
            <div class="field">
              <label for="telefono">Telefono *</label>
              <input id="telefono" name="telefono" type="tel" required autocomplete="tel" placeholder="Il tuo numero" />
            </div>
          </div>
          <div class="field">
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="la.tua@email.it" />
          </div>
          <div class="field">
            <label for="richiesta">La tua richiesta *</label>
            <textarea id="richiesta" name="richiesta" rows="4" required placeholder="Scrivici cosa ti serve: un prodotto, un noleggio, una pratica ASL/INAIL..."></textarea>
          </div>
          <label class="privacy">
            <input type="checkbox" required />
            <span>Ho letto l'<a href="/privacy" target="_blank">informativa privacy</a> e acconsento al trattamento dei miei dati per essere ricontattato. *</span>
          </label>
          <div class="form-note"></div>
          <button class="btn btn-solid" type="submit" style="justify-content:center;width:100%">
            Invia richiesta
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>
      </div>
    </div>
  </section>

