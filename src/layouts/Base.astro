---
interface Props { title?: string; description?: string; }
const {
  title = "Sanitaria Ortopedia di Elisabetta Zanghi — Torino",
  description = "Sanitaria e Ortopedia a Torino in Via Cherubini 22: busti, tutori, plantari, ausili, elettromedicali, noleggio e pratiche ASL e INAIL."
} = Astro.props;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://www.ortopediazanghi.it/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sanitaria Ortopedia di Elisabetta Zanghi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://www.ortopediazanghi.it/" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:image" content="https://cdn.jsdelivr.net/gh/vincenzobongiovanni80-cmyk/ortopedia-zanghi@main/public/hero-new.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Sanitaria Ortopedia di Elisabetta Zanghi",
    "url": "https://www.ortopediazanghi.it/",
    "description": "Sanitaria e ortopedia a Torino: busti e corsetti, tutori e ortesi, plantari e calzature ortopediche, ausili per incontinenza, elettromedicali, noleggio, pratiche ASL e INAIL.",
    "address": { "@type": "PostalAddress", "streetAddress": "Via Cherubini 22", "addressLocality": "Torino", "postalCode": "10154", "addressCountry": "IT" },
    "geo": { "@type": "GeoCoordinates", "latitude": 45.0925882, "longitude": 7.6970188 },
    "telephone": "+390114452294",
    "email": "sanitariaortopedia.zanghi@gmail.com",
    "openingHours": ["Mo 15:00-19:00", "Tu-Sa 09:00-12:30", "Tu-Sa 15:00-19:00"]
  }
  </script>
  <style is:global>
    :root {
      --bg: #0E2A30;
      --bg-deep: #0A2025;
      --bg-card: #123840;
      --teal: #2E7D86;
      --teal-bright: #4FB3BD;
      --cream: #F4EEE4;
      --cream-dim: rgba(244,238,228,.72);
      --cream-faint: rgba(244,238,228,.45);
      --taupe: #C9A88F;
      --taupe-bright: #E8CDBB;
      --line: rgba(244,238,228,.12);
      --serif: "Fraunces", Georgia, serif;
      --sans: "Manrope", system-ui, sans-serif;
      --ease: cubic-bezier(.22,.68,.24,1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); background: var(--bg-deep); color: var(--cream); line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    img { max-width: 100%; display: block; }
    a { color: inherit; }
    ::selection { background: var(--taupe); color: var(--bg-deep); }
    .wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); }

    /* ---------- Reveal animation ---------- */
    .rv { opacity: 0; transform: translateY(34px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
    .rv.in { opacity: 1; transform: none; }
    .rv-d1 { transition-delay: .08s; } .rv-d2 { transition-delay: .16s; } .rv-d3 { transition-delay: .24s; }

    /* ---------- Typography ---------- */
    .display { font-family: var(--serif); font-weight: 400; line-height: 1.02; letter-spacing: -.015em; }
    .display em { font-style: italic; font-weight: 500; color: var(--taupe-bright); }
    .eyebrow { display: inline-flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--taupe); }
    .eyebrow::before { content: ""; width: 34px; height: 1.5px; background: var(--taupe); }
    .sec-head { display: grid; grid-template-columns: auto 1fr; gap: clamp(20px,4vw,60px); align-items: end; margin-bottom: clamp(40px, 6vw, 72px); }
    .sec-head h2 { font-size: clamp(34px, 4.6vw, 58px); color: var(--cream); max-width: 640px; }
    .sec-head p { color: var(--cream-dim); font-size: clamp(15px, 1.4vw, 17px); max-width: 420px; padding-bottom: 8px; }

    /* ---------- Buttons ---------- */
    .btn { position: relative; display: inline-flex; align-items: center; gap: 12px; padding: 16px 30px; border-radius: 999px; font-weight: 700; font-size: 15px; text-decoration: none; letter-spacing: .01em; transition: all .35s var(--ease); cursor: pointer; border: 1.5px solid transparent; overflow: hidden; }
    .btn svg { width: 18px; height: 18px; transition: transform .35s var(--ease); }
    .btn:hover svg { transform: translateX(4px); }
    .btn-solid { background: var(--cream); color: var(--bg-deep); }
    .btn-solid:hover { background: var(--taupe-bright); transform: translateY(-2px); }
    .btn-ghost { border-color: var(--cream-faint); color: var(--cream); }
    .btn-ghost:hover { border-color: var(--cream); background: rgba(244,238,228,.06); transform: translateY(-2px); }
    .btn-wa { background: #25D366; color: #06281A; }
    .btn-wa:hover { background: #4be184; transform: translateY(-2px); }
    .btn-taupe { background: var(--taupe); color: var(--bg-deep); }
    .btn-taupe:hover { background: var(--taupe-bright); transform: translateY(-2px); }

    /* ---------- Header ---------- */
    header { position: fixed; inset: 0 0 auto; z-index: 100; transition: all .4s var(--ease); }
    header.scrolled { background: rgba(10,32,37,.85); backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 0; transition: padding .4s var(--ease); }
    header.scrolled .nav { padding: 10px 0; }
    .nav .logo { margin: -6px 0 -28px; }
    .nav .logo img { height: 92px; width: auto; transition: height .4s var(--ease); }
    header.scrolled .nav .logo { margin: -2px 0 -16px; }
    header.scrolled .nav .logo img { height: 66px; }
    .nav-links { display: flex; gap: 34px; list-style: none; }
    .nav-links a { position: relative; text-decoration: none; font-size: 14px; font-weight: 600; color: var(--cream-dim); letter-spacing: .02em; transition: color .3s; }
    .nav-links a::after { content: ""; position: absolute; left: 0; bottom: -6px; width: 0; height: 1.5px; background: var(--taupe-bright); transition: width .35s var(--ease); }
    .nav-links a:hover { color: var(--cream); }
    .nav-links a:hover::after { width: 100%; }
    .nav-cta { display: flex; gap: 10px; }
    .nav-cta .btn { padding: 11px 22px; font-size: 13.5px; }
    .menu-toggle { display: none; background: none; border: 0; cursor: pointer; padding: 6px; }
    .menu-toggle svg { width: 28px; height: 28px; stroke: var(--cream); }

    /* ---------- Promo evento in hero (temporanea) ---------- */
    .promo-hero { position: absolute; top: 112px; left: 50%; transform: translateX(-50%); z-index: 3; width: min(1080px, calc(100% - 40px)); display: flex; align-items: center; gap: 20px; background: rgba(244,238,228,.98); color: var(--bg-deep); border-radius: 18px; padding: 20px 26px; box-shadow: 0 30px 70px rgba(0,0,0,.5), 0 0 0 1px rgba(244,238,228,.25); animation: promoIn 1s var(--ease) .6s both; }
    @keyframes promoIn { from { opacity: 0; transform: translate(-50%,-18px); } to { opacity: 1; transform: translate(-50%,0); } }
    .promo-badge { flex: none; background: var(--bg-deep); color: var(--cream); font-weight: 800; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; padding: 12px 15px; border-radius: 12px; text-align: center; line-height: 1.2; }
    .promo-text { flex: 1; min-width: 0; }
    .promo-text strong { display: block; font-family: var(--serif); font-size: clamp(19px, 2.3vw, 25px); font-weight: 600; letter-spacing: .01em; }
    .promo-free { font-style: normal; display: inline-block; background: #25D366; color: #06281A; font-size: .6em; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; vertical-align: middle; margin-left: 8px; }
    .promo-text span { display: block; font-size: 14.5px; font-weight: 600; color: rgba(10,32,37,.72); margin-top: 4px; }
    .promo-cta { flex: none; display: inline-flex; align-items: center; gap: 8px; background: #25D366; color: #06281A; font-weight: 800; font-size: 15px; text-decoration: none; padding: 14px 24px; border-radius: 999px; transition: all .3s var(--ease); white-space: nowrap; }
    .promo-cta:hover { background: #4be184; transform: translateY(-2px); }
    .promo-cta svg { width: 18px; height: 18px; }
    .hero:has(.promo-hero) .hero-inner { padding-top: 215px; }
    @media (max-width: 720px) {
      .promo-hero { top: 92px; gap: 12px; padding: 16px 18px; flex-wrap: wrap; }
      .promo-text { flex-basis: calc(100% - 90px); }
      .promo-cta { width: 100%; justify-content: center; }
      .hero:has(.promo-hero) .hero-inner { padding-top: 290px; }
    }

    /* ---------- Hero ---------- */
    .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
    .hero-media { position: absolute; inset: 0; }
    .hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; transform: scale(1.08); animation: heroZoom 8s var(--ease) forwards; }
    @keyframes heroZoom { to { transform: scale(1); } }
    .hero-media::after { content: ""; position: absolute; inset: 0; background:
      linear-gradient(180deg, rgba(10,32,37,.55) 0%, rgba(10,32,37,.15) 40%, rgba(10,32,37,.88) 82%, var(--bg-deep) 100%),
      linear-gradient(100deg, rgba(10,32,37,.75) 0%, rgba(10,32,37,.2) 60%, transparent 100%); }
    .hero-inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(48px, 7vw, 88px); padding-top: 140px; }
    .hero .eyebrow { margin-bottom: 26px; animation: fadeUp 1s var(--ease) .2s both; }
    .hero h1 { font-size: clamp(44px, 7.2vw, 96px); color: var(--cream); max-width: 900px; margin-bottom: 28px; animation: fadeUp 1s var(--ease) .35s both; }
    .hero-sub { display: flex; gap: clamp(28px, 5vw, 80px); align-items: flex-end; justify-content: space-between; flex-wrap: wrap; animation: fadeUp 1s var(--ease) .5s both; }
    .hero-sub p { max-width: 480px; font-size: clamp(16px, 1.5vw, 18.5px); color: var(--cream-dim); }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
    .hero-strip { position: relative; z-index: 2; border-top: 1px solid var(--line); margin-top: clamp(40px, 5vw, 64px); }
    .hero-strip .wrap { display: grid; grid-template-columns: repeat(3, 1fr); }
    .hero-strip .cell { display: flex; align-items: center; gap: 14px; padding: 22px clamp(8px,2vw,24px); font-size: 14px; font-weight: 600; color: var(--cream-dim); }
    .hero-strip .cell + .cell { border-left: 1px solid var(--line); }
    .hero-strip svg { width: 24px; height: 24px; flex: none; }
    .hero-strip strong { color: var(--cream); }

    /* ---------- Marquee ---------- */
    .marquee { background: var(--taupe); color: var(--bg-deep); overflow: hidden; padding: 16px 0; transform: rotate(-1.2deg) scale(1.02); margin: 30px 0; }
    .marquee-track { display: flex; gap: 48px; width: max-content; animation: marquee 30s linear infinite; font-family: var(--serif); font-size: 20px; font-weight: 500; font-style: italic; white-space: nowrap; }
    .marquee-track span { display: flex; align-items: center; gap: 48px; }
    .marquee-track i { font-style: normal; font-size: 13px; }
    @keyframes marquee { to { transform: translateX(-50%); } }

    /* ---------- Sections ---------- */
    section { padding: clamp(80px, 10vw, 140px) 0; }

    /* ---------- ASL / INAIL ---------- */
    .asl-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(36px, 5vw, 80px); align-items: start; }
    .asl-copy p { color: var(--cream-dim); font-size: 16.5px; margin-bottom: 18px; max-width: 520px; }
    .asl-copy p strong { color: var(--cream); }
    .asl-quote { margin: 30px 0; padding: 26px 30px; border-left: 3px solid var(--taupe); background: var(--bg-card); border-radius: 0 18px 18px 0; font-family: var(--serif); font-size: 20px; font-style: italic; color: var(--cream); line-height: 1.45; }
    .steps { list-style: none; counter-reset: step; }
    .steps li { counter-increment: step; position: relative; padding: 26px 0 26px 92px; border-bottom: 1px solid var(--line); }
    .steps li:last-child { border-bottom: 0; }
    .steps li::before { content: "0" counter(step); position: absolute; left: 0; top: 22px; font-family: var(--serif); font-size: 44px; font-weight: 300; color: var(--taupe); font-style: italic; }
    .steps strong { display: block; font-size: 18px; font-weight: 800; color: var(--cream); margin-bottom: 5px; letter-spacing: -.01em; }
    .steps p { font-size: 15px; color: var(--cream-dim); }

    /* ---------- Prodotti ---------- */
    .prodotti { background: var(--cream); color: var(--bg-deep); }
    .prodotti .sec-head h2 { color: var(--bg-deep); }
    .prodotti .sec-head p { color: rgba(14,42,48,.65); }
    .prodotti .eyebrow { color: #8A6A52; }
    .prodotti .eyebrow::before { background: #8A6A52; }
    .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px; background: rgba(14,42,48,.12); border: 1.5px solid rgba(14,42,48,.12); border-radius: 22px; overflow: hidden; }
    .prod-card { position: relative; background: var(--cream); padding: 34px 28px 30px; transition: background .45s var(--ease); overflow: hidden; }
    .prod-card::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; background: var(--teal); transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease); }
    .prod-card:hover { background: #fff; }
    .prod-card:hover::after { transform: scaleX(1); }
    .prod-card .num { position: absolute; top: 22px; right: 24px; font-family: var(--serif); font-style: italic; font-size: 15px; color: rgba(14,42,48,.35); }
    .prod-card svg { width: 42px; height: 42px; margin-bottom: 22px; stroke: var(--teal); transition: transform .45s var(--ease); }
    .prod-card:hover svg { transform: translateY(-4px) rotate(-4deg); }
    .prod-card h3 { font-family: var(--sans); font-size: 16.5px; font-weight: 800; letter-spacing: -.01em; color: var(--bg-deep); margin-bottom: 8px; line-height: 1.3; }
    .prod-card p { font-size: 13.5px; line-height: 1.55; color: rgba(14,42,48,.62); }

    /* ---------- Chi siamo ---------- */
    .about-grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(36px, 5vw, 90px); align-items: center; }
    .about-photo { position: relative; }
    .about-photo img { border-radius: 22px; aspect-ratio: 4/5; object-fit: cover; }
    .about-photo::before { content: ""; position: absolute; inset: 22px -22px -22px 22px; border: 1.5px solid var(--taupe); border-radius: 22px; z-index: -1; }
    .about-badge { position: absolute; right: -18px; bottom: 34px; background: var(--taupe); color: var(--bg-deep); border-radius: 16px; padding: 18px 22px; font-weight: 800; font-size: 14px; line-height: 1.35; box-shadow: 0 20px 50px rgba(0,0,0,.35); }
    .about-badge span { display: block; font-family: var(--serif); font-style: italic; font-weight: 500; font-size: 26px; }
    .about-copy p { color: var(--cream-dim); font-size: 16.5px; margin-bottom: 16px; }
    .about-copy p strong { color: var(--cream); }
    .sign { margin: 26px 0 30px; font-family: var(--serif); font-style: italic; font-size: clamp(26px, 2.6vw, 34px); color: var(--taupe-bright); }
    .feats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 26px; }
    .feats div { display: flex; gap: 12px; align-items: flex-start; font-size: 14.5px; font-weight: 600; color: var(--cream-dim); }
    .feats svg { width: 20px; height: 20px; flex: none; margin-top: 2px; }

    /* ---------- Contatti ---------- */
    .contact-grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(36px, 5vw, 72px); align-items: start; }
    .contact-list { display: grid; gap: 12px; }
    .contact-item { display: flex; align-items: center; gap: 18px; padding: 20px 22px; border: 1.5px solid var(--line); border-radius: 18px; text-decoration: none; transition: all .35s var(--ease); }
    .contact-item:hover { border-color: var(--taupe); background: var(--bg-card); transform: translateX(6px); }
    .contact-item .ico { width: 48px; height: 48px; flex: none; border-radius: 14px; background: var(--bg-card); display: grid; place-items: center; transition: background .35s; }
    .contact-item:hover .ico { background: var(--taupe); }
    .contact-item .ico svg { width: 22px; height: 22px; }
    .contact-item:hover .ico svg * { stroke: var(--bg-deep); }
    .contact-item:hover .ico svg.fill path { fill: var(--bg-deep); stroke: none; }
    .contact-item small { display: block; font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--taupe); margin-bottom: 3px; }
    .contact-item b { font-size: 16.5px; font-weight: 700; color: var(--cream); letter-spacing: -.01em; }
    .contact-item span.sub { display: block; font-size: 13px; color: var(--cream-faint); }
    .map-frame { margin-top: 20px; border-radius: 18px; overflow: hidden; border: 1.5px solid var(--line); filter: grayscale(1) invert(.92) contrast(.9); }
    .map-frame iframe { width: 100%; height: 280px; border: 0; display: block; }

    form.quote { background: var(--bg-card); border: 1.5px solid var(--line); border-radius: 24px; padding: clamp(26px, 3vw, 40px); display: grid; gap: 18px; position: sticky; top: 110px; }
    form.quote h3 { font-family: var(--serif); font-weight: 500; font-size: 28px; color: var(--cream); }
    form.quote > p { font-size: 14.5px; color: var(--cream-dim); margin-top: -10px; }
    .f-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .field label { display: block; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; }
    .field input, .field textarea, .field select { width: 100%; padding: 14px 16px; border: 1.5px solid var(--line); border-radius: 12px; font: inherit; font-size: 15px; color: var(--cream); background: var(--bg-deep); transition: border-color .3s; }
    .field select option { color: #12282e; }
    .field input::placeholder, .field textarea::placeholder { color: var(--cream-faint); }
    .field input:focus, .field textarea:focus, .field select:focus { outline: none; border-color: var(--taupe); }
    .privacy { font-size: 12.5px; color: var(--cream-faint); display: flex; gap: 10px; align-items: flex-start; line-height: 1.5; }
    .privacy input { margin-top: 3px; accent-color: var(--taupe); }
    .form-note { display: none; background: rgba(37,211,102,.12); border: 1.5px solid rgba(37,211,102,.4); color: #8FF0B4; padding: 14px 16px; border-radius: 12px; font-size: 14.5px; font-weight: 600; }

    /* ---------- Big CTA ---------- */
    .bigcta { text-align: center; position: relative; overflow: hidden; }
    .bigcta h2 { font-size: clamp(40px, 6.4vw, 84px); color: var(--cream); max-width: 900px; margin: 22px auto 30px; }
    .bigcta p { color: var(--cream-dim); font-size: 17.5px; max-width: 560px; margin: 0 auto 38px; }
    .bigcta .hero-actions { justify-content: center; }
    .bigcta .glow { position: absolute; left: 50%; top: 50%; width: 720px; height: 720px; transform: translate(-50%,-50%); background: radial-gradient(circle, rgba(79,179,189,.14), transparent 60%); pointer-events: none; }

    /* ---------- Footer ---------- */
    footer { border-top: 1px solid var(--line); padding: 64px 0 30px; background: var(--bg-deep); }
    .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; margin-bottom: 50px; }
    footer img { height: 58px; width: auto; margin-bottom: 18px; }
    .brand-lockup { height: 76px; width: auto; margin-bottom: 30px; }
    .about-symbol { height: 104px; width: auto; margin-bottom: 22px; }
    footer p, footer li { font-size: 14.5px; color: var(--cream-faint); line-height: 1.8; }
    footer h4 { font-size: 12px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--taupe); margin-bottom: 14px; }
    footer ul { list-style: none; }
    footer a { text-decoration: none; color: var(--cream-dim); transition: color .3s; }
    footer a:hover { color: var(--taupe-bright); }
    .foot-bottom { border-top: 1px solid var(--line); padding-top: 24px; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: 13px; color: var(--cream-faint); }

    /* ---------- Pagina Privacy ---------- */
    .legal { padding: 170px 20px 90px; max-width: 820px; margin: 0 auto; }
    .legal h1 { font-family: var(--serif); font-size: clamp(32px, 4.5vw, 46px); color: var(--cream); margin-bottom: 10px; }
    .legal .upd { color: var(--cream-faint); font-size: 13.5px; margin-bottom: 40px; }
    .legal h2 { font-family: var(--serif); font-size: 23px; color: var(--taupe-bright); margin: 38px 0 12px; font-weight: 600; }
    .legal p, .legal li { color: var(--cream-dim); font-size: 15.5px; line-height: 1.85; }
    .legal ul { padding-left: 22px; }
    .legal li { margin-bottom: 6px; }
    .legal a { color: var(--taupe-bright); }
    .legal strong { color: var(--cream); }
    .legal .box { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 20px 24px; margin: 18px 0; }

    /* ---------- Mappa GDPR click-to-load ---------- */
    .map-gdpr { position: relative; width: 100%; height: 100%; min-height: 320px; border-radius: 18px; overflow: hidden; background: var(--bg); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; text-align: center; padding: 30px; }
    .map-gdpr p { color: var(--cream-dim); font-size: 14.5px; line-height: 1.7; margin: 0 0 16px; max-width: 380px; }
    .map-gdpr .btn-solid { cursor: pointer; border: 0; font-size: 14.5px; }
    .map-gdpr iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    /* ---------- WhatsApp float ---------- */
    .wa-float { position: fixed; right: 24px; bottom: 24px; z-index: 200; width: 62px; height: 62px; border-radius: 50%; background: #25D366; display: grid; place-items: center; box-shadow: 0 12px 34px rgba(37,211,102,.4); transition: transform .3s var(--ease); }
    .wa-float:hover { transform: scale(1.1) rotate(6deg); }
    .wa-float svg { width: 32px; height: 32px; fill: #fff; }
    .wa-float::before { content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid rgba(37,211,102,.5); animation: pulse 2.2s ease-out infinite; }
    @keyframes pulse { 0% { transform: scale(.85); opacity: 1; } 100% { transform: scale(1.35); opacity: 0; } }

    /* ---------- Responsive ---------- */
    @media (max-width: 1020px) {
      .prod-grid { grid-template-columns: repeat(2, 1fr); }
      .asl-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
      .sec-head { grid-template-columns: 1fr; gap: 14px; }
      .foot-grid { grid-template-columns: 1fr 1fr; }
      form.quote { position: static; }
      .about-badge { right: 10px; }
    }
    @media (max-width: 720px) {
      .nav .logo { margin: -2px 0 -12px; }
      .nav .logo img { height: 64px; }
      header.scrolled .nav .logo img { height: 52px; }
      .nav-links { display: none; }
      .nav-links.open { display: flex; position: absolute; top: 100%; left: 0; right: 0; background: rgba(10,32,37,.97); backdrop-filter: blur(16px); flex-direction: column; padding: 22px 24px 26px; gap: 18px; border-bottom: 1px solid var(--line); }
      .nav-links a { font-size: 16px; }
      .menu-toggle { display: block; }
      .nav-cta .btn-ghost { display: none; }
      .hero-strip .wrap { grid-template-columns: 1fr; }
      .hero-strip .cell + .cell { border-left: 0; border-top: 1px solid var(--line); }
      .f-row { grid-template-columns: 1fr; }
      .marquee-track { font-size: 17px; }
    }
    @media (max-width: 520px) {
      .prod-grid { grid-template-columns: 1fr; }
      .about-photo::before { display: none; }
      .foot-grid { grid-template-columns: 1fr; }
      .steps li { padding-left: 74px; }
      .steps li::before { font-size: 36px; }
    }
  </style>
</head>
<body>
  <slot />
  <script>
    // Header state
    const header = document.querySelector('header');
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    // Mobile menu
    const t = document.querySelector('.menu-toggle');
    const l = document.querySelector('.nav-links');
    t?.addEventListener('click', () => l.classList.toggle('open'));
    l?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => l.classList.remove('open')));
    // Reveal on scroll
    const io = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .12 });
    document.querySelectorAll('.rv').forEach(el => io.observe(el));
    // Form handling (Web3Forms)
    const form = document.getElementById('form-contatti');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const n = form.querySelector('.form-note');
      const btn = form.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.style.opacity = '.6';
      n.style.display = 'block';
      n.textContent = 'Invio in corso...';
      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } });
        const data = await res.json();
        if (data.success) {
          n.textContent = 'Richiesta inviata! Ti ricontatteremo al più presto. Grazie.';
          form.reset();
        } else {
          n.textContent = 'Qualcosa non ha funzionato. Riprova o scrivici su WhatsApp.';
        }
      } catch {
        n.textContent = 'Errore di connessione. Riprova o scrivici su WhatsApp.';
      }
      btn.disabled = false;
      btn.style.opacity = '1';
      n.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
</body>
</html>
